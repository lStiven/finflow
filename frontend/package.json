{
  "name": "finflow-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc --build && node scripts/check-deprecated.mjs && vitest run",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:deprecated": "node scripts/check-deprecated.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "openapi-typescript": "^7.9.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
