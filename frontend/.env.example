# Where the API lives. Vite only exposes variables prefixed with VITE_ to the
# browser, and everything here ends up in the bundle — never put a secret in
# this file.
#
# Local:      http://localhost:8000        (`just dev`)
# Deployed:   the ApiUrl output of the SAM stack, `just deploy-outputs-dev`
VITE_API_BASE_URL=http://localhost:8000
