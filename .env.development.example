# Development against its own AWS account, separate from production. Copy to
# `.env.development` and use it with `just provision-dev` / `just run-dev`.
#
# This file IS tracked by git — keep it a template. Your account id, profile
# name and sender list belong in `.env.development`, which is ignored.
#
# `ENVIRONMENT=development` is the whole safety mechanism: every DynamoDB
# table, every SQS queue and the EventBridge bus get a `dev-` prefix applied
# in code, so this environment cannot reach production's data even if a name
# below is wrong. Leave the names bare here — the prefix is added for you, and
# writing `dev-` yourself is harmless but redundant.
#
# Never write a key here or there. Credentials live in ~/.aws (named profile)
# locally, and come from the instance or task role when deployed.

ENVIRONMENT=development

AWS_REGION=us-east-1
# AWS_ENDPOINT_URL stays unset: this is a real account. Setting it to moto is
# allowed here (unlike production) and is how the flow gets rehearsed for
# free before it touches AWS.

# Configure it first with `aws configure --profile finflow-dev`. This is a
# *separate* AWS account from production, so the credentials are what keeps
# the two apart. The `dev-` prefix stays on top of that: a second line of
# defence, and the reason a mistyped account never lands on production's data.
AWS_PROFILE=finflow-dev

# --- API ---
# Origins allowed to call this API from a browser page it did not serve.
# Leave empty when the frontend is served from this same origin: then there is
# no cross-origin request to permit, and permitting one anyway only widens the
# surface. Comma-separated, e.g. http://localhost:5173 for a frontend running
# on your machine against this environment. `*` is refused outside
# ENVIRONMENT=local.
API_CORS_ORIGINS=http://localhost:5173

INGESTION_NOTIFICATIONS_TABLE=bank_notifications
INGESTION_EVENT_BUS_NAME=finflow
INGESTION_RETENTION_DAYS=90

# Provisioning creates the queue from the name. The application needs the full
# URL, which only exists once the queue does: run `just provision-dev` and
# paste the line it prints here.
INGESTION_PARSE_QUEUE_NAME=parse-notifications
INGESTION_PARSE_QUEUE_URL=

# On-demand, because the free allowance was costing more than it saved.
# PROVISIONED gives 25 read and 25 write units free across the account, and an
# index is charged like a table: five tables and two indexes at three units
# each already spent 21 of the 25, so every new index meant lowering capacity
# again. Three units is also roughly three 4 KB reads a second, and several
# endpoints read a whole partition.
#
# PAY_PER_REQUEST is billed from the first request, which at this deployment's
# volume (a handful of forwarded emails a day) is on the order of a cent a
# month. Switch back by setting PROVISIONED here: provisioning moves existing
# tables either way. On-demand matters more here than in production: a dev
# environment sits idle most of the time, and idle on-demand costs nothing
# while idle provisioned capacity is billed by the hour.
INGESTION_DYNAMODB_BILLING_MODE=PAY_PER_REQUEST
# Only read under PAY_PER_REQUEST: a ceiling on requests per second, per table
# and per index, so a runaway loop throttles instead of billing. A rate limit,
# not a budget — the guard for spending is a billing alarm on the account.
INGESTION_DYNAMODB_MAX_READ_UNITS=25
INGESTION_DYNAMODB_MAX_WRITE_UNITS=25
# Only read under PROVISIONED.
INGESTION_DYNAMODB_READ_CAPACITY=3
INGESTION_DYNAMODB_WRITE_CAPACITY=3

# Approved senders are no longer configuration: they are per-user data in the
# user_inboxes table. Register one with `just register-inbox`.
INGESTION_USER_INBOXES_TABLE=user_inboxes

IDENTITY_USERS_TABLE=users
# Signs access tokens. Required — the API refuses to start without it. Pull
# this from a secrets manager in a real deployment; never write the value
# here or commit it.
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ALGORITHM=HS256
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=1440
# Verification codes, registration tickets and password-reset links. Every
# record in here expires; DynamoDB's own sweep is what removes it.
IDENTITY_CHALLENGES_TABLE=credential_challenges
# Where that mail is sent from — the same Gmail account and App Password the
# ingest worker reads with will do: one casilla, IMAP in and SMTP out.
# Required: the API refuses to start without both, because a deployment that
# cannot mail a code is one where nobody can register or recover an account.
IDENTITY_MAIL_FROM_ADDRESS=
IDENTITY_MAIL_APP_PASSWORD=ssm:/finflow/development/mail-app-password
IDENTITY_MAIL_HOST=smtp.gmail.com
IDENTITY_MAIL_PORT=465
# The frontend page a reset link points at; the API appends `?token=...`.
# Must be https here: the token travels in the query string.
IDENTITY_PASSWORD_RESET_URL=

# The bus tap: EventBridge routes every finflow.* integration event here so
# `just events` can show them. Only that CLI reads it.
INGESTION_INTEGRATION_EVENTS_QUEUE_NAME=integration-events
INGESTION_INTEGRATION_EVENTS_QUEUE_URL=

# --- Merchant ---
# Canonical merchants, the spellings under them, and the events already
# applied. One table, partitioned by user.
MERCHANT_MERCHANTS_TABLE=merchants
# This context's own subscription: EventBridge routes ingestion's
# TransactionExtracted here, and `just merchant-worker` drains it. Without the
# URL the worker refuses to start, because every extracted transaction would
# go unattributed.
MERCHANT_EVENTS_QUEUE_NAME=merchant-events
MERCHANT_EVENTS_QUEUE_URL=

# --- Financial ---
# Accounts, the fingerprints they answer to, and the ledger of movements. One
# table, partitioned by user, because a balance and the rows behind it have to
# be written together.
FINANCIAL_ACCOUNTS_TABLE=financial
# This context's own subscription: EventBridge routes ingestion's
# TransactionExtracted here, and `just financial-worker` drains it. Without the
# URL the worker refuses to start, because every extracted transaction would
# leave balances untouched.
FINANCIAL_EVENTS_QUEUE_NAME=financial-events
FINANCIAL_EVENTS_QUEUE_URL=

# --- Ingest mailbox ---
# The one Gmail account every user forwards their bank email to, read over
# IMAP with an App Password — no OAuth, no Google Cloud project. Leave empty
# and the ingest worker refuses to start rather than polling nothing. See
# docs/email-forwarding.md for how to set the account up.
INGESTION_INGEST_MAILBOX_ADDRESS=
INGESTION_INGEST_MAILBOX_APP_PASSWORD=
INGESTION_INGEST_MAILBOX_HOST=imap.gmail.com
INGESTION_INGEST_MAILBOX_PORT=993
INGESTION_INGEST_POLL_INTERVAL_SECONDS=60

# --- Alerts ---
# Channels, the links that bind them, the chats they hold and what has already
# been sent. Namespaced by ENVIRONMENT, like every other table here.
ALERTS_CHANNELS_TABLE=alert_channels
ALERTS_EVENTS_QUEUE_NAME=alerts-events
ALERTS_EVENTS_QUEUE_URL=
# Both of these are secrets. Write them with `just secret-put` and leave the
# `ssm:` reference here — never the value itself, and never in git.
ALERTS_TELEGRAM_BOT_TOKEN=
ALERTS_TELEGRAM_BOT_USERNAME=
ALERTS_TELEGRAM_WEBHOOK_SECRET=
ALERTS_LINK_TTL_MINUTES=15
ALERTS_MAX_CHANNELS_PER_USER=5
ALERTS_DISPLAY_TIMEZONE=America/Bogota

# --- Language model (plan B) ---
# Gemini reads the bank alerts no deterministic template matched, and suggests
# which merchant a new spelling belongs to and what category it is. Leave the
# key empty and the fallback simply does not exist: templates still run and an
# unrecognised alert is kept rather than lost.
# Pull this from a secrets manager in a real deployment; never write the value
# here or commit it.
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARACTERS=40000
