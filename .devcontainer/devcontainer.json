{
  "name": "FinFlow V2 Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/finflow_v2",
  // `~/.aws` on a named volume so a rebuild does not take the credentials
  // with it. A volume and not a bind mount of the host's `~/.aws` on purpose:
  // nothing of the host's AWS configuration is exposed to this container, and
  // nothing lands in the workspace, where only `.gitignore` would stand
  // between a credential and a commit.
  "mounts": [
    "source=finflow-v2-aws,target=/home/vscode/.aws,type=volume"
  ],
  // `forwardPorts` (editor-tunnel detection) was tried first and did not
  // reach the browser reliably even after a rebuild, so this is real Docker
  // port publishing instead — it does not depend on the editor at all.
  // Docker Desktop's WSL2 backend forwards published ports to Windows
  // localhost on its own.
  //
  // Both are needed together. With only 5173 published the page loads and
  // every API call from it fails, because the fetch happens in the host's
  // browser, not in the container.
  //
  // Needs the container recreated to take effect, refuses to start if either
  // port is already taken on the host, and only works because `just dev` and
  // `just web` both listen on 0.0.0.0 — a 127.0.0.1 bind is invisible to a
  // published port.
  "appPort": ["5173:5173", "8000:8000"],
  "portsAttributes": {
    "5173": {
      "label": "frontend (vite)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "api (fastapi)",
      "onAutoForward": "silent"
    }
  },

  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_LINK_MODE": "copy",
    "SAM_CLI_TELEMETRY": "0"
  },
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1.1.4": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {},
    // The frontend in `frontend/` needs a toolchain the Python image has no
    // reason to carry. Pinned to an LTS line rather than "latest" for the
    // same reason `uv.lock` exists: a rebuild must not quietly move it.
    "ghcr.io/devcontainers/features/node:1.6.2": {
      "version": "24"
    }
  },
  // The last step downloads the Chromium `just shot` drives. It runs after
  // `npm ci` on purpose: Playwright refuses a browser whose build does not
  // match the package, so the version has to come from the tree that was just
  // installed. Its shared libraries are already in the image (see the
  // Dockerfile), so this needs no root and only fetches the binary.
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.aws && chmod 700 /home/vscode/.aws && uv tool install graphifyy && uv tool install aws-sam-cli && uv sync && npm --prefix frontend ci && npm --prefix frontend exec -- playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "AmazonWebServices.aws-toolkit-vscode",
        "DavidAnson.vscode-markdownlint",
        "anthropic.claude-code",
        "PKief.material-icon-theme",
        "dracula-theme.theme-dracula"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "workbench.iconTheme": "material-icon-theme",
        "workbench.colorTheme": "Dracula Theme Soft",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml",
          "editor.formatOnSave": true
        },
        "[markdown]": {
          "editor.formatOnSave": false
        },
        // Biome formats and lints the frontend — one tool instead of ESLint
        // plus Prettier plus the config packages that glue them together.
        // Root JSON and YAML stay with Prettier, which already handles them.
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true
        },
        "[javascript]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true
        },
        "[css]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true
        },
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    },
    "jetbrains": {
      "plugins": [
        "com.intellij.plugins.python",
        "fr.avodev.ruff",
        "com.intellij.plugins.yaml",
        "org.jetbrains.plugins.toml",
        "com.anthropicsdk.claude-jetbrains"
      ]
    }
  }
}
