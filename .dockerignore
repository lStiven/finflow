# Everything the image does not need. Smaller context, faster builds, and
# — the part that matters — no chance of an env file reaching a layer.
.env
.env.*
!.env.example
!.env.*.example

.git
.github
.venv
.devcontainer
.vscode
.claude

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pyright/

tests/
scripts/
docs/
infra/
*.md

# The frontend is a separate artifact: it deploys to a CDN, never into
# this image. Excluded for the build context, not the image — `node_modules`
# alone would be hundreds of megabytes sent to the daemon on every build.
frontend/
node_modules/

.coverage
.coverage.*
htmlcov/
coverage.xml
reports/
*.log
