# Las 91 operaciones de la API, por contexto. Fuente de
# docs/assets/api-map.svg; se regenera con
#
#   d2 docs/assets/api-map.d2 docs/assets/api-map.svg
#
# Las cifras salen de docs/openapi.json; si cambian, cambia la ruta aquí.
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

grid-rows: 2
grid-columns: 3
horizontal-gap: 40
vertical-gap: 40

heading: "La API: 91 operaciones en cinco contextos" {class: heading}
legend: "Sin prefijo /api ni versión · Authorization: Bearer <token> · dinero como string decimal · tiempos en epoch, segundos, UTC · lo ajeno responde 404, nunca 403" {
  class: note
  near: bottom-center
}

classes: {
  area: {
    width: 440
    height: 215
    style: {
      fill: "#14112B"
      stroke-width: 3
      border-radius: 14
      font-color: "#F8FAFC"
      font-size: 22
    }
  }
}

identity: "/identity · 11\n\nverification/request · confirm\nregister · login\npassword/forgot · reset · change\nme · inbox" {class: area; style.stroke: "#A78BFA"}
ingestion: "/ingestion · 4\n\nsetup: en qué paso va el alta\nnotifications: lo que llegó\nmodel-access: el modelo y sus strikes\ncatalog" {class: area; style.stroke: "#D946EF"}
merchants: "/merchants · 12\n\nlistar, detalle, renombrar\nconfirmar, mover alias\ncategorías propias\ncatalog" {class: area; style.stroke: "#F59E0B"}
financial: "/financial · 55\n\naccounts 16 · bills 14 · transactions 9\nbudgets 4 · plan 3\nsummary · trends · history · net-worth\nallowance · recurring · accrue · export" {class: area; width: 500; style.stroke: "#10B981"}
alerts: "/alerts · 8\n\nchannels: vincular Telegram\ninbox: la campana\ntelegram/webhook: lo llama Telegram" {class: area; style.stroke: "#60A5FA"}
health: "/health · 1\n\nvivo o no, y contra qué\nentorno: lo usa el smoke\npara no escribir en producción" {class: area; style.stroke: "#475569"}
