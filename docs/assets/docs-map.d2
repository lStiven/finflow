# Qué guía leer según lo que quieras hacer. Fuente de
# docs/assets/docs-map.svg; se regenera con
#
#   d2 docs/assets/docs-map.d2 docs/assets/docs-map.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

grid-rows: 1
grid-columns: 3
horizontal-gap: 40

heading: "Qué guía leer" {class: heading}
legend: "decisions.md es un archivo: se busca dentro, no se lee entero · los diagramas viven en docs/assets, con su .d2 al lado" {
  class: note
  near: bottom-center
}

classes: {
  lane: {
    grid-rows: 4
    vertical-gap: 16
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 24
      bold: true
    }
  }
  doc: {
    width: 360
    height: 92
    style: {
      fill: "#14112B"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 10
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
}

understand: "Entender" {
  class: lane
  style: {stroke: "#A78BFA"; font-color: "#DDD6FE"}
  a: "overview.md\nqué hace y por qué está partido así" {class: doc}
  b: "email-forwarding.md\ncómo se conecta un banco" {class: doc}
  c: "alerts.md\nlos avisos, y arreglarlos" {class: doc}
  d: "decisions.md\npor qué es así, y qué se descartó" {class: doc}
}
operate: "Operar" {
  class: lane
  style: {stroke: "#F59E0B"; font-color: "#FCD34D"}
  a: "running.md\nlevantarlo y cuándo algo falla" {class: doc}
  b: "deploy.md\nponerlo en AWS y publicar la web" {class: doc}
  c: "ci.md\nqué hace el pipeline en cada push" {class: doc}
  d: "model-strikes-copy.md\nlos textos aprobados de los strikes" {class: doc}
}
integrate: "Integrar" {
  class: lane
  style: {stroke: "#22D3EE"; font-color: "#A5F3FC"}
  a: "frontend-integration.md\nla API pantalla por pantalla" {class: doc}
  b: "openapi.json\nel contrato, de él salen los tipos" {class: doc}
  c: "postman/\nlas 91 operaciones, a mano" {class: doc}
  d: "../frontend/README.md\ntrabajar dentro del frontend" {class: doc}
}
