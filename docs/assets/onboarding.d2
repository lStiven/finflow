# El alta de un usuario, llamada por llamada: del registro al primer
# movimiento. Fuente de docs/assets/onboarding.svg; se regenera con
#
#   d2 docs/assets/onboarding.d2 docs/assets/onboarding.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

heading: "El alta, llamada por llamada" {class: heading}

flow: "" {
  shape: sequence_diagram
  style: {fill: "#0B0A1A"; stroke-width: 0; font-size: 18}

  app: "App web" {style: {fill: "#14112B"; stroke: "#A78BFA"; font-color: "#F8FAFC"; font-size: 20}}
  identity: "/identity" {style: {fill: "#14112B"; stroke: "#A78BFA"; font-color: "#F8FAFC"; font-size: 20}}
  ingestion: "/ingestion" {style: {fill: "#14112B"; stroke: "#D946EF"; font-color: "#F8FAFC"; font-size: 20}}
  financial: "/financial" {style: {fill: "#14112B"; stroke: "#10B981"; font-color: "#F8FAFC"; font-size: 20}}

  app -> identity: "POST verification/request" {style: {stroke: "#A78BFA"; font-color: "#DDD6FE"; font-size: 17}}
  identity -> app: "202 siempre · el código va al correo" {style: {stroke: "#64748B"; font-color: "#CBD5E1"; font-size: 17}}
  app -> identity: "POST verification/confirm" {style: {stroke: "#A78BFA"; font-color: "#DDD6FE"; font-size: 17}}
  identity -> app: "verification_token · 30 min, un uso" {style: {stroke: "#64748B"; font-color: "#CBD5E1"; font-size: 17}}
  app -> identity: "POST register" {style: {stroke: "#A78BFA"; font-color: "#DDD6FE"; font-size: 17}}
  identity -> app: "201 · access_token, y la dirección ya existe" {style: {stroke: "#10B981"; font-color: "#6EE7B7"; font-size: 17}}
  app -> identity: "GET inbox · PATCH inbox" {style: {stroke: "#A78BFA"; font-color: "#DDD6FE"; font-size: 17}}
  identity -> app: "la dirección y los remitentes aprobados" {style: {stroke: "#64748B"; font-color: "#CBD5E1"; font-size: 17}}
  app -> ingestion: "GET setup, mientras la pantalla esté abierta" {style: {stroke: "#D946EF"; font-color: "#F0ABFC"; font-size: 17}}
  ingestion -> app: "current · ready · gmail_filter" {style: {stroke: "#64748B"; font-color: "#CBD5E1"; font-size: 17}}
  app -> financial: "GET transactions · summary · net-worth" {style: {stroke: "#10B981"; font-color: "#6EE7B7"; font-size: 17}}
  financial -> app: "lo que llegó, aun sin cuentas declaradas" {style: {stroke: "#64748B"; font-color: "#CBD5E1"; font-size: 17}}
}
