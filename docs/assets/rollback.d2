# Cómo el pipeline despliega y, si algo falla, vuelve solo a lo anterior.
# Fuente de docs/assets/rollback.svg; se regenera con
#
#   d2 docs/assets/rollback.d2 docs/assets/rollback.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

direction: right

heading: "Desplegar, comprobar y, si falla, volver" {class: heading}
legend: "verde: sí · rojo: no · aprovisionar no se revierte: crea o ajusta tablas y colas, nunca borra" {
  class: note
  near: bottom-center
}

deploy: "deploy.sh <entorno>\nbackend y web juntos" {class: card; style.stroke: "#FF9900"}
smoke: "¿Pasan el despliegue\ny el smoke?" {class: card; style.stroke: "#A78BFA"}
tag: "Mueve la etiqueta\ndeployed/<entorno>\nal commit nuevo" {class: good}
prune: "Limpia imágenes\nviejas de ECR" {class: good}
had: "¿Hay etiqueta\ndeployed/<entorno>?" {class: card; style.stroke: "#A78BFA"}
back: "La saca en ../previous\ny corre el mismo deploy.sh\ny el smoke sobre ella" {class: hold}
red: "La ejecución\ntermina en rojo" {class: drop}

deploy -> smoke: {class: event}
smoke -> tag: {class: yes}
tag -> prune: {class: yes}
smoke -> had: {class: no}
had -> back: {class: yes}
had -> red: {class: no}
back -> red: {class: quiet}
