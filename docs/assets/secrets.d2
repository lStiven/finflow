# Cómo viaja un secreto de tu terminal a la Lambda, y dónde está la trampa.
# Fuente de docs/assets/secrets.svg; se regenera con
#
#   d2 docs/assets/secrets.d2 docs/assets/secrets.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

grid-rows: 2
grid-columns: 4
horizontal-gap: 56
vertical-gap: 56

heading: "Cómo viaja un secreto" {class: heading}
legend: "El valor nunca pasa por git ni por la imagen: la plantilla solo guarda rutas.\nRotar es el mismo secret-put, y se aplica al volver a desplegar: cada proceso lo lee una vez." {
  class: note
  near: bottom-center
}

put: "just secret-put\n/finflow/<entorno>/jwt-secret\n\nel valor por prompt,\nnunca como argumento" {class: card; width: 330; height: 170; style: {stroke: "#F59E0B"; stroke-width: 3}}
ssm: "Parameter Store\nSecureString en esa ruta" {
  class: card
  width: 330
  height: 170
  style: {stroke: "#FF4F8B"; stroke-width: 3}
  icon: https://icons.terrastruct.com/aws%2FManagement%20%26%20Governance%2FAWS-Systems-Manager_Parameter-Store_light-bg.svg
  icon.near: bottom-center
}
override: "infra/samconfig.toml\nJwtSecretParameter=\n/finflow/<entorno>/jwt-secret" {class: card; width: 330; height: 170; style: {stroke: "#A78BFA"; stroke-width: 3}}
lambda: "La Lambda arranca con\nssm:/finflow/<entorno>/…\ny resuelve el valor" {
  class: good
  width: 330
  height: 170
  icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
  icon.near: bottom-center
}

g1: "" {width: 330; height: 150; style.opacity: 0}
g2: "" {width: 330; height: 150; style.opacity: 0}
trap: "¿Se olvidó el override?\nel default de la plantilla\napunta a /finflow/production/\ndevelopment lee producción, sin error" {class: drop; width: 330; height: 150}
guard: "Al añadir un secreto nuevo:\nva en los dos bloques\nparameter_overrides\nen el mismo cambio" {class: hold; width: 330; height: 150}

put -> ssm: {class: event}
ssm -> override: {class: event}
override -> lambda: {class: event}
override -> trap: {class: no}
trap -> guard: {class: quiet}
