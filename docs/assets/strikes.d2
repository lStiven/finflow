# La escalera de strikes del modelo. Fuente de docs/assets/strikes.svg; se
# regenera con
#
#   d2 docs/assets/strikes.d2 docs/assets/strikes.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

grid-rows: 1
grid-columns: 4
horizontal-gap: 64

heading: "Los strikes del modelo" {class: heading}
legend: "Cada ráfaga nueva sube un escalón · un strike caduca a los 90 días · solo se suspende el modelo: las plantillas siguen leyendo · reactivar borra los strikes" {
  class: note
  near: bottom-center
}

burst: "10 correos que no son\nde un banco\nen menos de una hora\n(según el modelo)" {
  class: card
  width: 270
  height: 160
  style.stroke: "#A78BFA"
}
one: "Strike 1\n\nel modelo no lee\nsus correos\nun día" {
  class: hold
  width: 230
  height: 160
}
two: "Strike 2\n\ntres días,\ny el aviso dice\nque es el último" {
  class: hold
  width: 230
  height: 160
  style.stroke: "#FB923C"
}
three: "Strike 3\n\npara siempre,\nhasta que un operador\nlo reactive" {
  class: drop
  width: 250
  height: 160
}

burst -> one: {class: no}
one -> two: {class: no}
two -> three: {class: no}
