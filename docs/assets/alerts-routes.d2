# Por dónde sale cada aviso del contexto Alerts. Fuente de
# docs/assets/alerts-routes.svg; se regenera con
#
#   d2 docs/assets/alerts-routes.d2 docs/assets/alerts-routes.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

direction: right

heading: "Alerts: qué avisa y por dónde" {class: heading}
legend: "cian: si el canal tiene ese tipo encendido (y, en un movimiento, sobre su monto mínimo) · ámbar: siempre, aunque haya apagado los avisos\nSe pregunta antes de mandar y se anota después: el mismo evento dos veces no avisa dos veces" {
  class: note
  near: bottom-center
}

moved: "Se movió plata\nMovementRecorded, de Financial" {class: card; width: 380; style.stroke: "#10B981"}
monday: "Lunes 08:00 de Bogotá\nresumen de la semana anterior" {class: card; width: 380; style.stroke: "#60A5FA"}
paused: "El modelo dejó de leer\nModelReadingSuspended, de Ingestion" {class: card; width: 380; style.stroke: "#D946EF"}

bell: "La campana de la app\n30 días, con o sin Telegram" {class: good; width: 300}
telegram: "Telegram\ncada canal vinculado" {class: good; width: 300}
mail: "Correo\na la dirección de Identity" {class: hold; width: 300}

moved -> bell: {class: event}
moved -> telegram: {class: event}
monday -> bell: {class: event}
monday -> telegram: {class: event}
paused -> bell: {class: quiet; style: {stroke: "#F59E0B"; stroke-dash: 0; stroke-width: 2}}
paused -> telegram: {class: quiet; style: {stroke: "#F59E0B"; stroke-dash: 0; stroke-width: 2}}
paused -> mail: {class: quiet; style: {stroke: "#F59E0B"; stroke-dash: 0; stroke-width: 2}}
