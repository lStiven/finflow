# Cómo Financial convierte un evento en un saldo. Fuente de
# docs/assets/financial-flow.svg; se regenera con
#
#   d2 docs/assets/financial-flow.d2 docs/assets/financial-flow.svg
vars: {
  d2-config: {
    theme-id: 200
    layout-engine: elk
    pad: 32
    # Texto claro y fondo oscuro fijos, con cualquier tema que se elija.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N7: "#0B0A1A"
    }
  }
}

style.fill: "#0B0A1A"

classes: {
  heading: {
    shape: text
    near: top-center
    style: {font-size: 30; bold: true; font-color: "#F8FAFC"}
  }
  note: {
    shape: text
    style: {font-size: 18; font-color: "#94A3B8"}
  }
  card: {
    style: {
      fill: "#14112B"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 20
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#1E1B4B"
      stroke: "#A78BFA"
      stroke-width: 2
      font-color: "#EDE9FE"
      font-size: 18
    }
  }
  good: {
    style: {
      fill: "#052E1B"
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  hold: {
    style: {
      fill: "#2A1A05"
      stroke: "#F59E0B"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  drop: {
    style: {
      fill: "#3B0A12"
      stroke: "#F43F5E"
      stroke-width: 2
      border-radius: 12
      font-color: "#F8FAFC"
      font-size: 19
    }
  }
  ctx: {
    style: {
      fill: "#120F24"
      stroke-width: 3
      border-radius: 16
      font-size: 20
      bold: true
      shadow: true
    }
  }
  mail: {
    style: {
      stroke: "#D946EF"
      stroke-width: 3
      animated: true
      font-color: "#F0ABFC"
      font-size: 17
    }
  }
  event: {
    style: {
      stroke: "#22D3EE"
      stroke-width: 3
      animated: true
      font-color: "#A5F3FC"
      font-size: 17
    }
  }
  yes: {
    style: {
      stroke: "#10B981"
      stroke-width: 2
      font-color: "#6EE7B7"
      font-size: 17
    }
  }
  no: {
    style: {
      stroke: "#F43F5E"
      stroke-width: 2
      font-color: "#FDA4AF"
      font-size: 17
    }
  }
  quiet: {
    style: {
      stroke: "#64748B"
      stroke-dash: 4
      font-color: "#94A3B8"
      font-size: 17
    }
  }
}

direction: down

heading: "Del evento al saldo" {class: heading}
legend: "verde: sí · rojo: no · un traslado son dos movimientos, cada uno con su clave y su cuenta" {
  class: note
  near: bottom-center
}

event: "TransactionExtracted\no TransferExtracted" {
  class: card
  style.stroke: "#22D3EE"
}
manual: "Un movimiento a mano\nefectivo, un débito sin aviso" {class: card}
key: "¿Clave nueva?\nhash de usuario, banco,\ninstrumento, monto, hora…" {
  class: card
  style.stroke: "#A78BFA"
}
same: "Nada que hacer\nel dinero se movió una vez" {class: drop}
account: "¿Tiene cuenta?\nla de su huella (banco, instrumento,\núltimos cuatro), o la que elegiste" {
  class: card
  style.stroke: "#A78BFA"
}
ledger: "Fila del ledger + saldo\nen una sola escritura atómica" {class: good}
unassigned: "Fila sin asignar\nsin tocar saldos;\nse guarda, nunca se adivina" {class: hold}
declare: "Declaras la cuenta\nla adopta y recalcula\nreproduciendo el ledger" {class: card}
worth: "Patrimonio neto\nactivos − pasivos" {class: good}
published: "MovementRecorded\nAlerts te avisa en los dos\ncasos, y dice si quedó sin asignar" {class: good; style.stroke: "#22D3EE"}

event -> key: {class: event}
manual -> key: {class: quiet}
key -> same: {class: no}
key -> account: {class: yes}
account -> ledger: {class: yes}
account -> unassigned: {class: no}
unassigned -> declare: {class: quiet}
declare -> ledger: {class: quiet}
ledger -> worth: {class: yes}
ledger -> published: {class: event}
unassigned -> published: {class: event}
