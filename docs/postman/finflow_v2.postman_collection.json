{
  "info": {
    "name": "finflow_v2",
    "description": "Finflow backend API. Requests are grouped by bounded context, the same way the codebase is (Identity, Ingestion, Merchant, Financial). Import the sibling `finflow_v2.postman_environment.json` alongside this file and select it before sending requests.\n\nAuth flow: run Identity > Auth > Register (or Login) once — its test script reads the response and fills `fetch_token`, `token`, and `user_id` on the active environment automatically. Every authenticated request below sends `Authorization: {{token}}`.\n\nSee docs/email-forwarding.md and docs/running.md for the narrative version of this API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const body = pm.response.json();",
                      "    pm.environment.set('fetch_token', body.access_token);",
                      "    pm.environment.set('token', 'Bearer ' + body.access_token);",
                      "    pm.environment.set('user_id', body.user_id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-long-real-passphrase\",\n  \"allowed_domains\": [],\n  \"allowed_addresses\": []\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/identity/register",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "identity",
                    "register"
                  ]
                },
                "description": "Creates an account, assigns it a forwarding address, and returns a usable access token. `allowed_domains`/`allowed_addresses` are optional — approved senders can be set later via `PATCH /identity/inbox`. The forwarding address itself is always assigned regardless; see Identity > Inbox > Get inbox to read it. On success, the test script fills `fetch_token`/`token`/`user_id` on this environment."
              },
              "response": []
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    pm.environment.set('fetch_token', body.access_token);",
                      "    pm.environment.set('token', 'Bearer ' + body.access_token);",
                      "    pm.environment.set('user_id', body.user_id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-long-real-passphrase\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/identity/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "identity",
                    "login"
                  ]
                },
                "description": "Same response as Register for an existing account. Same error for an unknown email and a wrong password on purpose. On success, the test script fills `fetch_token`/`token`/`user_id` on this environment."
              },
              "response": []
            },
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/me",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "identity",
                    "me"
                  ]
                },
                "description": "Whoever the bearer token verifies as."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Inbox",
          "item": [
            {
              "name": "Get inbox",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/inbox",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "identity",
                    "inbox"
                  ]
                },
                "description": "The caller's forwarding address (assigned automatically at registration) and who is currently approved to send to it."
              },
              "response": []
            },
            {
              "name": "Update approved senders",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"allowed_domains\": [\"an.notificacionesbancolombia.com\"],\n  \"allowed_addresses\": []\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/identity/inbox",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "identity",
                    "inbox"
                  ]
                },
                "description": "Replaces — not merges — who may send to the caller's forwarding address. Leave both lists empty and the address is approved for nobody, the safe default. See docs/email-forwarding.md for the full flow, including how the user then sets up the actual forwarding rule in their own mail client."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ingestion/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingestion",
                "catalog"
              ]
            },
            "description": "Processing statuses, the reasons behind them, and instrument_kinds — the words a bank alert arrives with. An account declared with any other spelling is accepted and then never matches an alert."
          },
          "response": []
        },
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ingestion/notifications?limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingestion",
                "notifications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "received | queued | processing | processed | pending_fallback | failed | ignored",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "What arrived for the authenticated caller, newest first — the only read surface ingestion has, and the one that tells the three failures apart: nothing arrived, it arrived from a sender nobody approved (status `ignored`, and its sender is shown so it can be approved), or it arrived and nothing could be read out of it (`pending_fallback`, with `deferred_reason` saying whether a model declined it or none was configured). Never returns the email body. `counts` is every status this user has, filter or no filter, so a summary line does not move when the list is narrowed. The index behind it is eventually consistent: a message received a moment ago can take an instant to appear."
          },
          "response": []
        },
        {
          "name": "Local testing",
          "item": [
            {
              "name": "Bank notification webhook (local only)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recipient\": \"REPLACE_WITH_ADDRESS_FROM_GET_INBOX\",\n  \"message_id\": \"<unique-message-id@example.com>\",\n  \"sender\": \"alertasynotificaciones@an.notificacionesbancolombia.com\",\n  \"subject\": \"Aviso de transacción\",\n  \"raw_content\": \"Bancolombia: Compraste $45.000 en EXITO CALI con tu T.Cred *1234, el 20/08/2026 a las 10:15\",\n  \"received_at\": null\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/ingestion/bank-notifications",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "ingestion",
                    "bank-notifications"
                  ]
                },
                "description": "A local testing seam, not a product path — only mounted when ENVIRONMENT=local. Stands in for the ingest worker: accepts one raw email body directly, bypassing IMAP and the shared ingest mailbox entirely. `recipient` must be a real forwarding address from Get inbox. Always 202, even for an unknown recipient."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Merchant",
      "item": [
        {
          "name": "Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                "catalog"
              ]
            },
            "description": "Categories, sorts, statuses, alias origins and counterparty kinds. Supersedes Categories, which stays for clients already calling it."
          },
          "response": []
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                "categories"
              ]
            },
            "description": "The fixed category vocabulary, for a dropdown that cannot drift from it."
          },
          "response": []
        },
        {
          "name": "List merchants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/merchants?search=&sort=last_seen&limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Free text, matched against merchant/alias names"
                },
                {
                  "key": "category",
                  "value": "",
                  "description": "One of the Categories values, e.g. groceries",
                  "disabled": true
                },
                {
                  "key": "needs_review",
                  "value": "",
                  "description": "true / false",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "last_seen",
                  "description": "name | last_seen | times_seen"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Scoped to the authenticated caller only. `needs_review` in the response counts across everything the user owns, not just this page, so a badge does not move while typing in the search box."
          },
          "response": []
        },
        {
          "name": "Get merchant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Full detail, including every alias (child spelling). 404 both when the id never existed and when it belongs to another user."
          },
          "response": []
        },
        {
          "name": "Edit merchant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Éxito\",\n  \"category\": \"groceries\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Rename, recategorize, or both — at least one of the two fields is required. Either counts as reviewing it, so it leaves the review queue."
          },
          "response": []
        },
        {
          "name": "Confirm merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId",
                "confirm"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Accepts the merchant as it stands, guessed children (aliases) included."
          },
          "response": []
        },
        {
          "name": "Move alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fingerprint\": \"REPLACE_WITH_FINGERPRINT\",\n  \"target_merchant_id\": \"REPLACE_WITH_TARGET_MERCHANT_ID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/aliases/move",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId",
                "aliases",
                "move"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Reattaches one spelling (alias) from the merchant in the path to `target_merchant_id`. Permanent: from here on that spelling resolves by exact match, never re-derived by a rule."
          },
          "response": []
        },
        {
          "name": "Split alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fingerprint\": \"REPLACE_WITH_FINGERPRINT\",\n  \"display_name\": \"New Merchant Name\",\n  \"category\": \"uncategorized\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/aliases/split",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId",
                "aliases",
                "split"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Pulls one spelling out of the merchant in the path into a brand-new merchant of its own, and returns that new merchant. 201 on success."
          },
          "response": []
        },
        {
          "name": "Merge merchants",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"absorbed_merchant_id\": \"REPLACE_WITH_ABSORBED_MERCHANT_ID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/merge",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "merchants",
                ":merchantId",
                "merge"
              ],
              "variable": [
                {
                  "key": "merchantId",
                  "value": ""
                }
              ]
            },
            "description": "Folds `absorbed_merchant_id` into the merchant named in the path, which survives with everything the absorbed one had."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Financial",
      "description": "Accounts are declared, never discovered. Finflow works with none at all — every alert is recorded and every movement stays unassigned, which is a complete answer for somebody who only wants to see what came in and what went out. Declaring an account is what starts the association, and it is retroactive: the alerts that already arrived under that card are adopted and the balance replays from them.",
      "item": [
        {
          "name": "Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/financial/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "catalog"
              ]
            },
            "description": "Every vocabulary this context's endpoints accept: account kinds (each with the side of net worth it lands on), currencies, movement directions, transaction origins and statuses, account scopes and summary groupings. Call it before rendering any form that posts here. The instrument vocabulary is Ingestion's — see Ingestion > Catalog."
          },
          "response": []
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/financial/accounts?scope=open",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "accounts"
              ],
              "query": [
                {
                  "key": "scope",
                  "value": "open",
                  "description": "open | closed | all"
                }
              ]
            },
            "description": "Every account the caller declared, with what each holds now, plus net worth per currency. Balances are signed: an asset legitimately goes below zero when no opening balance was stated, and a liability's positive amount is what is owed."
          },
          "response": []
        },
        {
          "name": "Open account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tarjeta Bancolombia\",\n  \"kind\": \"credit_card\",\n  \"currency\": \"COP\",\n  \"opening_balance\": null,\n  \"bank\": \"Bancolombia\",\n  \"instrument_kind\": \"credit_card\",\n  \"last_four\": \"7653\",\n  \"credit_limit\": \"12000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/financial/accounts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "accounts"
              ]
            },
            "description": "Declare an account. `instrument_kind` must come from `/financial/catalog` -> instrument_kinds: it is what the BANK calls the thing the money moved through, not what you call the account. A savings account is kind `savings`, and its transfers arrive as instrument `account`. On a liability, `opening_balance` is what has been spent so far and `credit_limit` is what may be spent — two different numbers."
          },
          "response": []
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/financial/accounts/:accountId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "accounts",
                ":accountId"
              ],
              "variable": [
                {
                  "key": "accountId",
                  "value": ""
                }
              ]
            },
            "description": "An account belonging to somebody else reads as missing rather than forbidden."
          },
          "response": []
        },
        {
          "name": "Rename account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tarjeta principal\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/financial/accounts/:accountId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "accounts",
                ":accountId"
              ],
              "variable": [
                {
                  "key": "accountId",
                  "value": ""
                }
              ]
            },
            "description": "Renaming changes nothing else — balance and instruments stay."
          },
          "response": []
        },
        {
          "name": "Set credit limit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/financial/accounts/:accountId/credit-limit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "financial",
                "accounts",
                ":accountId",
                "credit-limit"
              ],
              "variable": [
                {
                  "key": "accountId",
                  "value": "{{account_id}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credit_limit\": \"12000000\"\n}"
            },
            "description": "State or restate what this card may owe. Liabilities only. Send null to clear it. The response carries `available` = limit minus what is owed, signed: a card over its limit reports a negative rather than zero."
          },
          "response": []
        },
        {
          "name": "Link instrument",
          "request": {
            "method": "POST",
