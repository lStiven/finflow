{
  "info": {
    "name": "finflow_v2",
    "description": "Finflow backend API. Requests are grouped by bounded context, the same way the codebase is (Identity, Ingestion, Merchant — Financial is not implemented yet). Import the sibling `finflow_v2.postman_environment.json` alongside this file and select it before sending requests.\n\nAuth flow: run Identity > Auth > Register (or Login) once — its test script reads the response and fills `fetch_token`, `token`, and `user_id` on the active environment automatically. Every authenticated request below sends `Authorization: {{token}}`.\n\nSee docs/mailbox-connection.md and docs/running.md for the narrative version of this API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    const body = pm.response.json();",
                      "    pm.environment.set('fetch_token', body.access_token);",
                      "    pm.environment.set('token', 'Bearer ' + body.access_token);",
                      "    pm.environment.set('user_id', body.user_id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-long-real-passphrase\",\n  \"inboxes\": []\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/identity/register",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "register"]
                },
                "description": "Creates an account and returns a usable access token. `inboxes` is optional — an account can be created bare and inboxes attached later via `POST /identity/inboxes`. On success, the test script fills `fetch_token`/`token`/`user_id` on this environment."
              },
              "response": []
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    pm.environment.set('fetch_token', body.access_token);",
                      "    pm.environment.set('token', 'Bearer ' + body.access_token);",
                      "    pm.environment.set('user_id', body.user_id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-long-real-passphrase\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/identity/login",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "login"]
                },
                "description": "Same response as Register for an existing account. Same error for an unknown email and a wrong password on purpose. On success, the test script fills `fetch_token`/`token`/`user_id` on this environment."
              },
              "response": []
            },
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/me",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "me"]
                },
                "description": "Whoever the bearer token verifies as."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Inboxes",
          "item": [
            {
              "name": "Add inboxes",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"inboxes\": [\n    {\n      \"address\": \"you@gmail.com\",\n      \"allowed_domains\": [\"an.notificacionesbancolombia.com\"],\n      \"allowed_addresses\": []\n    }\n  ]\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/identity/inboxes",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "inboxes"]
                },
                "description": "Registers an inbound address and the senders trusted for it, for the authenticated user. This is the sender-filter half of a mailbox connection — see Mailboxes > Connect mailbox, which does both in one call for the common case."
              },
              "response": []
            },
            {
              "name": "List inboxes",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/inboxes",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "inboxes"]
                },
                "description": "The caller's own inboxes. Whose inboxes to read comes from the verified token, never from the request."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Mailboxes",
          "item": [
            {
              "name": "Connect mailbox (simulated)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"address\": \"you@gmail.test\",\n  \"provider\": \"simulated\",\n  \"allowed_domains\": [\"an.notificacionesbancolombia.com\"],\n  \"allowed_addresses\": []\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes"]
                },
                "description": "One call on purpose: connects the mailbox AND registers the sender filter, so a connection is never left reading nothing without the caller knowing. For the real Gmail provider the address is never sent here directly — see Gmail OAuth below; this same endpoint is called again afterwards with the address Google confirmed."
              },
              "response": []
            },
            {
              "name": "List mailboxes",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes"]
                },
                "description": "Connected mailboxes and their status (active / needs_reauth / revoked). `needs_attention: true` means the user has to redo the Gmail OAuth flow."
              },
              "response": []
            },
            {
              "name": "Disconnect mailbox",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"address\": \"you@gmail.test\",\n  \"provider\": \"simulated\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes"]
                },
                "description": "Stops reading a mailbox. The record and its read cursor are kept, so a later reconnect resumes instead of re-reading everything."
              },
              "response": []
            },
            {
              "name": "Refresh mailboxes",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes/refresh",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes", "refresh"]
                },
                "description": "Catches every one of the caller's mailboxes up right now and renews subscriptions on the way past. Meant to be called when someone opens the app; also the manual stand-in for a push notification when there is no public webhook URL to receive one (e.g. plain localhost)."
              },
              "response": []
            },
            {
              "name": "Backfill current month",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes/backfill",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes", "backfill"]
                },
                "description": "Opt-in, one-time catch-up: reads every active mailbox from midnight UTC on the first of the current month up to now, independent of the incremental sync cursor. Meant to be offered right after connecting a mailbox, so signing up mid-month does not mean losing that month's earlier history. Safe to call more than once — anything already ingested comes back as `duplicates`, never twice."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Gmail OAuth",
          "item": [
            {
              "name": "Start Gmail authorization",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "{{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes/gmail/authorize",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes", "gmail", "authorize"]
                },
                "description": "Returns the Google consent URL rather than redirecting to it — open `authorization_url` in an actual browser (Postman/Bruno cannot complete Google's login+consent flow). 503 if this deployment has no Gmail client configured."
              },
              "response": []
            },
            {
              "name": "Gmail OAuth callback",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/identity/mailboxes/gmail/callback?code=REPLACE_WITH_CODE&state=REPLACE_WITH_STATE",
                  "host": ["{{base_url}}"],
                  "path": ["identity", "mailboxes", "gmail", "callback"],
                  "query": [
                    { "key": "code", "value": "REPLACE_WITH_CODE" },
                    { "key": "state", "value": "REPLACE_WITH_STATE" }
                  ]
                },
                "description": "Where Google redirects the user's browser back to — not meant to be called directly from Postman/Bruno. Documented here for reference: no Authorization header (the browser carries none on a redirect), identity comes entirely from the signed `state` issued by Start Gmail authorization."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Mailbox events (provider doorbell)",
          "item": [
            {
              "name": "Simulated mailbox event",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"address\": \"you@gmail.test\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/ingestion/mailbox-events/simulated",
                  "host": ["{{base_url}}"],
                  "path": ["ingestion", "mailbox-events", "simulated"]
                },
                "description": "The doorbell for the simulated provider, standing in for a real push notification — this is what `just mailbox-notify` calls. Unauthenticated by design: a provider notification names no user, only a mailbox address, and carries no message content."
              },
              "response": []
            },
            {
              "name": "Gmail push notification (Pub/Sub)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": {\n    \"data\": \"eyJlbWFpbEFkZHJlc3MiOiAieW91QGdtYWlsLmNvbSIsICJoaXN0b3J5SWQiOiAiMTIzNDU2In0=\",\n    \"messageId\": \"1234567890\"\n  },\n  \"subscription\": \"projects/your-project/subscriptions/your-subscription\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/ingestion/mailbox-events/gmail",
                  "host": ["{{base_url}}"],
                  "path": ["ingestion", "mailbox-events", "gmail"]
                },
                "description": "Google Pub/Sub calls this in production — not meant to be called by hand. Kept here for reference and for replaying a real payload while debugging. `data` is base64 JSON `{\"emailAddress\": \"...\"}`; the example decodes to `you@gmail.com`. Always answers 204, even for an unreadable envelope (Pub/Sub retries anything else for days)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Local testing",
          "item": [
            {
              "name": "Bank notification webhook (local only)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recipient\": \"you@gmail.test\",\n  \"message_id\": \"<unique-message-id@example.com>\",\n  \"sender\": \"alertasynotificaciones@an.notificacionesbancolombia.com\",\n  \"subject\": \"Aviso de transacción\",\n  \"raw_content\": \"Bancolombia: Compraste $45.000 en EXITO CALI con tu T.Cred *1234, el 20/08/2026 a las 10:15\",\n  \"received_at\": null\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/ingestion/bank-notifications",
                  "host": ["{{base_url}}"],
                  "path": ["ingestion", "bank-notifications"]
                },
                "description": "A local testing seam, not a product path — only mounted when ENVIRONMENT=local. Accepts one raw email body directly, bypassing any mailbox provider entirely. Always 202, even for an unknown recipient."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Merchant",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/categories",
              "host": ["{{base_url}}"],
              "path": ["merchants", "categories"]
            },
            "description": "The fixed category vocabulary, for a dropdown that cannot drift from it."
          },
          "response": []
        },
        {
          "name": "List merchants",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/merchants?search=&category=&needs_review=&sort=last_seen&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["merchants"],
              "query": [
                { "key": "search", "value": "", "description": "Free text, matched against merchant/alias names" },
                { "key": "category", "value": "", "description": "One of the Categories values, e.g. groceries" },
                { "key": "needs_review", "value": "", "description": "true / false" },
                { "key": "sort", "value": "last_seen", "description": "name | last_seen | times_seen" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Scoped to the authenticated caller only. `needs_review` in the response counts across everything the user owns, not just this page, so a badge does not move while typing in the search box."
          },
          "response": []
        },
        {
          "name": "Get merchant",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Full detail, including every alias (child spelling). 404 both when the id never existed and when it belongs to another user."
          },
          "response": []
        },
        {
          "name": "Edit merchant",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Éxito\",\n  \"category\": \"groceries\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Rename, recategorize, or both — at least one of the two fields is required. Either counts as reviewing it, so it leaves the review queue."
          },
          "response": []
        },
        {
          "name": "Confirm merchant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/confirm",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId", "confirm"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Accepts the merchant as it stands, guessed children (aliases) included."
          },
          "response": []
        },
        {
          "name": "Move alias",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fingerprint\": \"REPLACE_WITH_FINGERPRINT\",\n  \"target_merchant_id\": \"REPLACE_WITH_TARGET_MERCHANT_ID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/aliases/move",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId", "aliases", "move"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Reattaches one spelling (alias) from the merchant in the path to `target_merchant_id`. Permanent: from here on that spelling resolves by exact match, never re-derived by a rule."
          },
          "response": []
        },
        {
          "name": "Split alias",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fingerprint\": \"REPLACE_WITH_FINGERPRINT\",\n  \"display_name\": \"New Merchant Name\",\n  \"category\": \"uncategorized\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/aliases/split",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId", "aliases", "split"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Pulls one spelling out of the merchant in the path into a brand-new merchant of its own, and returns that new merchant. 201 on success."
          },
          "response": []
        },
        {
          "name": "Merge merchants",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "{{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"absorbed_merchant_id\": \"REPLACE_WITH_ABSORBED_MERCHANT_ID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/merchants/:merchantId/merge",
              "host": ["{{base_url}}"],
              "path": ["merchants", ":merchantId", "merge"],
              "variable": [
                { "key": "merchantId", "value": "" }
              ]
            },
            "description": "Folds `absorbed_merchant_id` into the merchant named in the path, which survives with everything the absorbed one had."
          },
          "response": []
        }
      ]
    }
  ]
}
