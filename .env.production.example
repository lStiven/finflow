# Production-shaped run against a real AWS account. Copy to `.env.production`
# and use it with `just provision-prod` / `just run-prod`.
#
# This file IS tracked by git — keep it a template. Your account id, profile
# name and sender list belong in `.env.production`, which is ignored.
#
# Never write a key here or there. Credentials live in ~/.aws (named profile)
# locally, and come from the instance or task role when deployed. The
# application passes whatever it resolves to `boto3.Session`; it never reads
# credentials behind your back.

ENVIRONMENT=production

AWS_REGION=us-east-1
# Deliberately absent: AWS_ENDPOINT_URL is refused in production, so a stale
# emulator address can never redirect real traffic.

# Configure it first with `aws configure --profile finflow-production`.
# Leave unset when deployed, so boto3 picks up the instance/task role instead.
AWS_PROFILE=finflow-production

INGESTION_NOTIFICATIONS_TABLE=bank_notifications
INGESTION_EVENT_BUS_NAME=finflow
INGESTION_RETENTION_DAYS=90

# Provisioning creates the queue from the name. The application needs the full
# URL, which only exists once the queue does: run `just provision-prod` and
# paste the line it prints here.
INGESTION_PARSE_QUEUE_NAME=parse-notifications
INGESTION_PARSE_QUEUE_URL=

# Free tier: DynamoDB gives 25 GB plus 25 read and 25 write units always free,
# but only for PROVISIONED tables — PAY_PER_REQUEST is billed from the first
# request. Keep this table small so the other contexts fit in the same budget.
INGESTION_DYNAMODB_BILLING_MODE=PROVISIONED
INGESTION_DYNAMODB_READ_CAPACITY=5
INGESTION_DYNAMODB_WRITE_CAPACITY=5

# Approved senders are no longer configuration: they are per-user data in the
# user_inboxes table. Register one with `just register-inbox`.
INGESTION_USER_INBOXES_TABLE=user_inboxes

IDENTITY_USERS_TABLE=users
# Signs access tokens. Required — the API refuses to start without it. Pull
# this from a secrets manager in a real deployment; never write the value
# here or commit it.
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ALGORITHM=HS256
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=1440

# The bus tap: EventBridge routes every finflow.* integration event here so
# `just events` can show them. Only that CLI reads it.
INGESTION_INTEGRATION_EVENTS_QUEUE_NAME=integration-events
INGESTION_INTEGRATION_EVENTS_QUEUE_URL=

# --- Merchant ---
# Canonical merchants, the spellings under them, and the events already
# applied. One table, partitioned by user.
MERCHANT_MERCHANTS_TABLE=merchants
# This context's own subscription: EventBridge routes ingestion's
# TransactionExtracted here, and `just merchant-worker` drains it. Without the
# URL the worker refuses to start, because every extracted transaction would
# go unattributed.
MERCHANT_EVENTS_QUEUE_NAME=merchant-events
MERCHANT_EVENTS_QUEUE_URL=

# --- Mailbox providers ---
INGESTION_MAILBOX_CONNECTIONS_TABLE=mailbox_connections
INGESTION_SIMULATED_MAILBOX_TABLE=simulated_mailbox

# Signs the `state` that ties a Gmail callback to the user who started it.
# Required before /identity/mailboxes/gmail/authorize will work.
INGESTION_OAUTH_STATE_SECRET=

# Gmail. Leave empty and the provider simply does not exist in this
# deployment. Fill all four to turn it on:
#   1. Create OAuth credentials (Web application) in Google Cloud.
#   2. Add the redirect URI below to that client, exactly.
#   3. Create a Pub/Sub topic, grant gmail-api-push@system.gserviceaccount.com
#      the Publisher role on it, and point a push subscription at
#      <your-api>/ingestion/mailbox-events/gmail
INGESTION_GMAIL_CLIENT_ID=
INGESTION_GMAIL_CLIENT_SECRET=
INGESTION_GMAIL_REDIRECT_URI=https://your-domain/identity/mailboxes/gmail/callback
INGESTION_GMAIL_PUBSUB_TOPIC=

# --- Language model (plan B) ---
# Gemini reads the bank alerts no deterministic template matched, and suggests
# which merchant a new spelling belongs to and what category it is. Leave the
# key empty and the fallback simply does not exist: templates still run and an
# unrecognised alert is kept rather than lost.
# Pull this from a secrets manager in a real deployment; never write the value
# here or commit it.
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARACTERS=40000
